# ENVIRONMENT

# NOTES

# - ALL NUMBERS FOR TIME ARE IN SECONDS

# OPERATING_MODE: 'development' or 'production'

OPERATING_MODE='development'

# PostgreSQL Configuration

POSTGRESQL_DATABASE_NAME='your_database_name'
POSTGRESQL_USERNAME='your_database_user'
POSTGRESQL_PASSWORD='your_database_password'
POSTGRESQL_HOST='localhost'
POSTGRESQL_PORT='5432'

# Pool Configuration

POSTGRESQL_POOL_SIZE='10'
POSTGRESQL_POOL_MAX_OVERFLOW='20'
POSTGRESQL_POOL_TIMEOUT_SECONDS='30'
POSTGRESQL_POOL_RECYCLE_SECONDS='1800'
POSTGRESQL_POOL_PRE_PING='true'

# API Configuration

API_ENABLED='true'
API_PORT='8000'

# Security

API_KEY_PEPPER='generate_a_random_secret'
PASSWORD_PEPPER='generate_a_random_secret'
JWT_SECRET='generate_a_random_secret'
JWT_ALGORITHM='HS256'
JWT_EXP_MINUTES='45'

API_KEY_TOKEN_BYTES='48'

PASSWORD_HASH_ITERATIONS='180000'
PASSWORD_HASH_ALGORITHM='pbkdf2_sha256'

COOKIE_DEFAULT_RATE_LIMIT='100'
RATE_LIMIT_WINDOW_SECONDS='60'

# Login throttling (app-level defaults)

LOGIN_ATTEMPTS_LIMIT='8'
LOGIN_TIME_WINDOW='1200'

# IP Blocking (app-level defaults)

# default block is 200 requests within 15 seconds = blocked for 30 minutes

IP_BLOCKING_ENABLED='true'
IP_BLOCKING_THRESHOLD='200'
IP_BLOCKING_TIME_WINDOW='15'
IP_BLOCKING_DURATION='1800'

# Redis Configuration

REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_PASSWORD='your_redis_password'

# Test Configuration

SYSTEM_TEST_BASE_URL='http://127.0.0.1:8000'
SYSTEM_TEST_SUPER_ADMIN_KEY='replace_with_test_api_key'

# Transactional email (Brevo)
PUBLIC_APP_URL='http://localhost:8000'
BREVO_API_KEY=''
BREVO_FROM_EMAIL=''
BREVO_FROM_NAME='Database Service'
BREVO_REQUEST_TIMEOUT_SECONDS='10'
