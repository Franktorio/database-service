# ENVIRONMENT

# OPERATING_MODE: 'development' or 'production'
# DEFAULT: 'development'
OPERATING_MODE='development'


# PostgreSQL Configuration
POSTGRESQL_DATABASE_NAME='ndg-database'
POSTGRESQL_USERNAME='postgres'
POSTGRESQL_PASSWORD='securepassword123'
POSTGRESQL_HOST='localhost'
POSTGRESQL_PORT='5432'

# API Configuration
API_ENABLED='true'
API_PORT='8000'

# Security
API_KEY_PEPPER='change-me-before-production'
PASSWORD_PEPPER='change-me-before-production'
JWT_SECRET='change-me-before-production'
JWT_ALGORITHM='HS256'
JWT_COOKIE_NAME='auth_token'
JWT_EXP_MINUTES='60'
API_KEY_TOKEN_BYTES='64'
PASSWORD_HASH_ITERATIONS='210000'
PASSWORD_HASH_ALGORITHM='pbkdf2_sha256'
COOKIE_DEFAULT_RATE_LIMIT='120'
RATE_LIMIT_WINDOW_SECONDS='60'

# Login throttling (app-level defaults)
LOGIN_ATTEMPTS_LIMIT='10'
LOGIN_TIME_WINDOW='1800'