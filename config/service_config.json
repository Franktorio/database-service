{
    "backup":
    {
        "enabled": true,
        "interval": 1800,
        "retention": 20,
        "backup_dir": "backups",
        "subprocess_timeout_seconds": 30
    },
    "dbhealthchecker":
    {
        "enabled": true,
        "auto_rollover": true,
        "shutdown_on_failure": true,
        "leniency": 3,
        "interval": 60,
        "backup_dir": "backups",
        "healthcheck_subprocess_timeout_seconds": 30,
        "restore_subprocess_timeout_seconds": 30
    },
    "setup_postgres":
    {
        "command_subprocess_timeout_seconds": 60,
        "probe_subprocess_timeout_seconds": 60
    },
    "ratelimit_cache":
    {
        "enabled": true,
        "sweep_interval": 60,
        "max_inactive_seconds": 900
    },
    "ip_block_cache":
    {
        "enabled": true,
        "sweep_interval": 60,
        "max_inactive_seconds": 900
    }
}